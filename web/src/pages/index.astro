---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import { site } from '../data/site';

const title = "Annie's Havens — A Trusted Provider of Foster Care in Ontario";
const description =
  "Annie's Havens is a licensed Ontario foster care provider. Since 1991 we've supported foster families and partners with training, guidance, and a team that understands fostering firsthand.";

// Real homepage FAQ (drawn from the site's FAQ page)
const faqs = [
  {
    q: 'What’s the difference between fostering with a CAS and Annie’s Havens?',
    a: 'Both a Children’s Aid Society and Annie’s Havens are licensed by the Province of Ontario each year using the same criteria. The support we provide to children and foster families is structured a little differently, and we’re a smaller, dedicated team focused on getting the match and the support right.',
  },
  {
    q: 'What if I’m single?',
    a: 'Single applicants are always welcome. As with every applicant, what we assess is the ability to meet the needs of a child in care — including time, commitment, and the support around you.',
  },
  {
    q: 'Is Annie’s Havens LGBTQ2S friendly?',
    a: 'Absolutely. Annie’s Havens is committed to a safe and inclusive environment for all LGBTQ2S individuals, and we are proud of the caregivers in our community who identify as such.',
  },
  {
    q: 'How much are foster parents reimbursed?',
    a: 'Foster parents aren’t “paid” in the usual sense. A daily per diem covers the costs of caring for a child — clothing, food, hygiene, and a contribution to household costs. Annie’s Havens caregivers receive $80–$85 per child per day depending on experience and the supports a child needs. It isn’t a replacement for steady income.',
  },
  {
    q: 'We’ve been thinking about fostering for years. Can we start right away?',
    a: 'We can begin the application quickly. Background checks, a home study, and orientation training all take time, but with prompt paperwork and a flexible schedule it can take as little as two months to open your home for placement consideration — our goal is no more than three.',
  },
];

const programs = [
  {
    title: 'Mainstream',
    base: '/images/mainstream-child-boy',
    formats: ['avif', 'webp'] as ('avif' | 'webp')[],
    alt: 'A happy young child playing',
    body: 'Every child in care carries some emotional weight — leaving home and being placed with new people is hard. “Mainstream” simply describes children without a known diagnosis or serious acting-out behaviours. It’s often the most straightforward fostering, though these referrals are a smaller share of what we see.',
    href: '/care-programs#mainstream',
  },
  {
    title: 'Special Needs',
    base: '/images/special-needs-child',
    formats: [] as ('avif' | 'webp')[],
    alt: 'A child receiving attentive care',
    body: 'Many foster children in Ontario live with a developmental, physical, or mental-health need. These homes require extra training and support, and Annie’s Havens is proud to offer one of the most highly regarded special-needs programs in the province — our homes are consistently commended for their care.',
    href: '/care-programs#special-needs',
  },
  {
    title: 'Trauma-Focused',
    base: '/images/trauma-youth',
    formats: [] as ('avif' | 'webp')[],
    alt: 'A thoughtful teenager outdoors',
    body: 'The need for trauma-focused homes has grown sharply, and they’re in short supply. Caregivers complete a trauma-focused curriculum before accepting referrals. The challenge is real — so are the rewards. This program is provided by our sister agency, Safe Harbours Family Treatment Homes.',
    href: site.sisterAgency.url,
  },
];

// Support items with distinct, meaningful icons.
const supports = [
  { icon: 'headset', h: 'A Dedicated Case Manager', p: 'A worker who knows your family and walks alongside you.' },
  { icon: 'cap', h: 'Ongoing Training', p: 'Practical, trauma-informed learning before placement and throughout.' },
  { icon: 'coin', h: 'Per-Diem Reimbursement', p: 'Caregiving costs are covered so fostering is sustainable.' },
  { icon: 'pulse', h: 'Medical Costs Covered', p: 'Major costs like dental, medication and devices are covered through Children’s Aid.' },
  { icon: 'layers', h: 'Specialized Programs', p: 'Higher-needs and trauma-focused care backed by clinical expertise.' },
  { icon: 'users', h: 'An Inclusive Community', p: 'A welcoming home for caregivers and children of every background.' },
] as const;
---
<BaseLayout title={title} description={description}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="badge"><span class="star">★</span> A Trusted Ontario Foster Care Provider Since {site.founded}</span>
        <h1>Steady Homes for the Children Who Need Them <em>Most</em>.</h1>
        <p class="lede">Annie's Havens supports foster families and partners across Ontario with training, ongoing guidance, and a team that has been doing this for more than three decades.</p>
        <div class="hero-cta">
          <a class="btn btn-pri" href="#contact">Talk to Our Team</a>
          <a class="btn btn-out" href="#how">How Fostering Works</a>
        </div>
      </div>
      <div class="hero-media">
        <Picture
          base="/images/carousel1"
          alt="A foster family walking together, holding hands"
          width={600}
          height={400}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1440, 1920]}
          sizes="(min-width: 920px) 540px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="verify"><span class="chk"><Icon name="shield" /></span><div><b>Fully supported</b><br /><span>Licensed &amp; trauma-informed care</span></div></div>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY STRIP -->
  <div class="strip">
    <div class="wrap">
      <span class="lbl">Trusted across Ontario for</span>
      <div class="stat"><b>30+</b><span>years of foster care</span></div>
      <div class="divider"></div>
      <div class="stat"><b>Licensed</b><span>by the Province of Ontario</span></div>
      <div class="divider"></div>
      <div class="stat"><b>All ages</b><span>infants to teens</span></div>
      <div class="divider"></div>
      <div class="stat"><b>Costs covered</b><span>so fostering is sustainable</span></div>
    </div>
  </div>

  <!-- WHO WE HELP -->
  <section class="pad" id="who">
    <div class="wrap">
      <div class="sec-head center">
        <h2>Whether You Can Open a Home or Open a Door</h2>
        <p>Most people who reach out fall into one of these. Tell us which sounds like you.</p>
      </div>
      <div class="split">
        <div class="panel reveal">
          <div class="ic"><Icon name="home" /></div>
          <h3>I Want to Foster</h3>
          <p>You have room in your home and your life for a child who needs stability. We'll guide you from your very first question through your first placement — and well beyond.</p>
          <a class="more" href="#how">Start Fostering <span class="arr">→</span></a>
        </div>
        <div class="panel dark reveal">
          <div class="ic"><Icon name="briefcase" /></div>
          <h3>I Work with Children</h3>
          <p>Social workers, Children's Aid Societies, schools and community partners — connect with us to refer a child, coordinate care, or explore working together.</p>
          <a class="more" href="/referral-sources">Partner with Us <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="pad how" id="how">
    <div class="wrap">
      <div class="sec-head center">
        <h2>How Becoming a Foster Parent Works</h2>
      </div>
      <div class="timeline">
        <div class="tnode reveal"><div class="tdot">1</div><h3>Get in Touch</h3><p>Ask us anything. A real member of our team answers — no commitment required.</p></div>
        <div class="tnode reveal"><div class="tdot">2</div><h3>Assessment</h3><p>Background checks and a home study, completed together step by step.</p></div>
        <div class="tnode reveal"><div class="tdot">3</div><h3>Training</h3><p>Trauma-informed preparation, including PRIDE training, so you feel ready.</p></div>
        <div class="tnode reveal"><div class="tdot">4</div><h3>Placement</h3><p>A thoughtful match, then ongoing support for as long as you foster.</p></div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="pad how" id="programs">
    <div class="wrap">
      <div class="sec-head">
        <h2>Care Matched to a Child's Needs</h2>
        <p>We offer a range of programs to meet the diverse needs of children in care across Ontario.</p>
      </div>
      <div class="prog-rows">
        {programs.map((p) => (
          <article class="prog-row reveal">
            <div class="prog-media">
              <Picture base={p.base} formats={p.formats} alt={p.alt} width={800} height={600} loading="lazy" />
            </div>
            <div class="prog-text">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <a class="more" href={p.href}>Learn More <span class="arr">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SUPPORT -->
  <section class="pad support" id="support">
    <div class="wrap">
      <div class="sec-head">
        <h2>What Every Annie's Havens Family Receives</h2>
        <p>We've been foster parents ourselves. The support we offer is the support we wished we'd had.</p>
      </div>
      <div class="slist">
        {supports.map((s) => (
          <div class="srow reveal"><span class="sic"><Icon name={s.icon} /></span><div><h3>{s.h}</h3><p>{s.p}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FOUNDER QUOTE -->
  <section class="pad quote">
    <div class="wrap quote-grid">
      <img class="portrait reveal" src="/images/hilda-wilson.jpg" alt="Hilda Wilson, founder of Annie's Havens" width="420" height="420" loading="lazy" decoding="async" />
      <div class="reveal">
        <blockquote class="serif">"My late husband William and I had been foster parents since 1991, and together we founded Annie's Havens. It has always been our mission to make sure children leave care with the best chances for success. Having been foster parents ourselves, we truly understand the daily lives of our families."</blockquote>
        <div class="who">Hilda Wilson<span>Founder of Annie's Havens · fostering since 1991</span></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pad" id="faq">
    <div class="wrap" style="max-width:860px">
      <div class="sec-head center" style="margin-left:auto;margin-right:auto">
        <h2>You Probably Have Questions. Good.</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class="faq-item">
            <button class="faq-q" type="button" aria-expanded="false" id={`faq-q-${i}`} aria-controls={`faq-a-${i}`}>{f.q}<span class="pm" aria-hidden="true"></span></button>
            <div class="faq-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}><div><p>{f.a}</p></div></div>
          </div>
        ))}
      </div>
      <p style="margin-top:28px"><a class="btn btn-out" href="/faq">See All Questions →</a></p>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="pad cta" id="contact">
    <div class="wrap cta-grid">
      <div class="reveal">
        <h2>Reach Out Today. We'll Take It from Here.</h2>
        <p>Share a few details and a member of our team will get back to you. No pressure — just a conversation.</p>
        <div class="ways">
          <div class="way"><span class="wic"><Icon name="phone" /></span><a href={site.phoneHref}>{site.phone}</a></div>
          <div class="way"><span class="wic"><Icon name="mail" /></span><a href={`mailto:${site.newHomesEmail}`}>{site.newHomesEmail}</a></div>
          <div class="way"><span class="wic"><Icon name="pin" /></span>{site.address.street}, {site.address.city}, {site.address.region}</div>
        </div>
      </div>
      <div>
        <form class="contact" id="contact-form" novalidate>
          <h3>Send Us a Message</h3>
          <p class="sub">Fields marked <span class="req" aria-hidden="true">*</span> are required. An email or a phone number is fine — fill in whichever you prefer.</p>
          <div class="frow">
            <div class="field"><label for="f-first">First name <span class="req" aria-hidden="true">*</span></label><input id="f-first" name="first" required aria-required="true" aria-describedby="err-first" /><div class="errmsg" id="err-first" role="alert">Required</div></div>
            <div class="field"><label for="f-last">Last name <span class="opt">(optional)</span></label><input id="f-last" name="last" /></div>
          </div>
          <div class="frow">
            <div class="field"><label for="f-email">Email <span class="req" id="req-email" aria-hidden="true">*</span></label><input id="f-email" name="email" type="email" aria-required="true" aria-describedby="err-email" /><div class="errmsg" id="err-email" role="alert">Enter a valid email</div></div>
            <div class="field"><label for="f-phone">Phone <span class="req" id="req-phone" aria-hidden="true">*</span></label><input id="f-phone" name="phone" type="tel" aria-required="true" aria-describedby="err-phone" /><div class="errmsg" id="err-phone" role="alert">Required</div></div>
          </div>
          <div class="field"><label for="f-role">I am a… <span class="req" aria-hidden="true">*</span></label>
            <select id="f-role" name="role" required aria-required="true" aria-describedby="err-role">
              <option value="">Select one</option>
              <option>Prospective Foster Parent</option>
              <option>Current Foster Family</option>
              <option>Professional / Agency Partner</option>
              <option>Community Supporter</option>
              <option>Something Else</option>
            </select>
            <div class="errmsg" id="err-role" role="alert">Please choose one</div>
          </div>
          <div class="field"><label for="f-msg">Message <span class="req" aria-hidden="true">*</span></label><textarea id="f-msg" name="msg" placeholder="How can we help?" required aria-required="true" aria-describedby="err-msg"></textarea><div class="errmsg" id="err-msg" role="alert">Please add a short message</div></div>
          <button type="submit" id="submit-btn" class="btn btn-coral" style="width:100%;justify-content:center;padding:15px">Submit Message</button>
        </form>
        <div class="form-ok" id="form-ok" role="status" tabindex="-1">
          <svg class="ok-check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="25"/><path d="M14 27l8 8 16-18"/></svg>
          <h3>Thank You for Reaching Out.</h3>
          <p style="color:var(--muted)">A real person on our team reads every message, and we'll get back to you within one business day. Talk soon.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Scroll reveals
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // FAQ accordion (single-open)
  document.querySelectorAll<HTMLButtonElement>('.faq-q').forEach((q) => {
    q.addEventListener('click', () => {
      const item = q.closest('.faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach((i) => {
        i.classList.remove('open');
        i.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) { item.classList.add('open'); q.setAttribute('aria-expanded', 'true'); }
    });
  });

  // Contact form — client validation only for now.
  // TODO (Phase 4): POST to /api/contact (Cloudflare Pages Function) with
  // Turnstile token; send via Resend. Until then this does NOT email anyone.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const emailRe = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
    const fieldOf = (n: string) => document.getElementById('f-' + n)?.closest('.field') ?? null;
    const setErr = (n: string, msg: string) => {
      const field = fieldOf(n);
      const input = document.getElementById('f-' + n);
      const errEl = document.getElementById('err-' + n);
      if (msg) {
        field?.classList.add('err');
        input?.setAttribute('aria-invalid', 'true');
        if (errEl) errEl.textContent = msg;
      } else {
        field?.classList.remove('err');
        input?.removeAttribute('aria-invalid');
      }
    };

    // Required: first name, an email OR phone, role, and message.
    // Email, if provided, must be valid. Last name is optional.
    const errorsFor = () => {
      const email = val('email'), phone = val('phone');
      const errs: Record<string, string> = {};
      if (!val('first')) errs.first = 'Required';
      if (email && !emailRe.test(email)) errs.email = 'Enter a valid email';
      else if (!email && !phone) { errs.email = 'Enter an email or phone number'; errs.phone = 'Enter an email or phone number'; }
      if (!val('role')) errs.role = 'Please choose one';
      if (!val('msg')) errs.msg = 'Please add a short message';
      return errs;
    };

    // Email & phone both read as required until one is filled — then the
    // other is no longer required (asterisk + aria-required drop).
    const updateContactReq = () => {
      const emailFilled = !!val('email'), phoneFilled = !!val('phone');
      const toggle = (name: string, required: boolean) => {
        const star = document.getElementById('req-' + name);
        if (star) star.style.display = required ? '' : 'none';
        document.getElementById('f-' + name)?.setAttribute('aria-required', required ? 'true' : 'false');
      };
      toggle('email', !phoneFilled); // email required unless phone is filled
      toggle('phone', !emailFilled); // phone required unless email is filled
    };

    const refresh = () => {
      updateContactReq();
      if (submitBtn) submitBtn.disabled = Object.keys(errorsFor()).length > 0;
    };

    // Show a field's error when the user leaves it.
    ['first', 'email', 'phone', 'role', 'msg'].forEach((n) => {
      document.getElementById('f-' + n)?.addEventListener('blur', () => {
        const errs = errorsFor();
        setErr(n, errs[n] || '');
      });
    });

    // Clear errors as the user types, and keep the button state live.
    form.querySelectorAll('input, select, textarea').forEach((el) =>
      el.addEventListener('input', () => {
        setErr((el as HTMLInputElement).name, '');
        // contact group: clear both once satisfied
        if ((val('email') && emailRe.test(val('email'))) || val('phone')) { setErr('email', ''); setErr('phone', ''); }
        refresh();
      })
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const errs = errorsFor();
      const order = ['first', 'email', 'phone', 'role', 'msg'];
      if (Object.keys(errs).length) {
        order.forEach((n) => setErr(n, errs[n] || ''));
        const firstBad = order.find((n) => errs[n]);
        if (firstBad) document.getElementById('f-' + firstBad)?.focus();
        return;
      }
      form.style.display = 'none';
      const okEl = document.getElementById('form-ok');
      okEl?.classList.add('show');
      okEl?.focus();
    });

    refresh(); // start disabled until the form is valid
  }
</script>
