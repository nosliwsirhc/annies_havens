---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ReadMore from '../components/ReadMore.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const readMore = [
  { href: '/faq', label: 'Frequently Asked Questions' },
  { href: '/care-programs', label: 'Our Care Programs' },
  { href: '/children-in-care', label: 'Children in Care' },
  { href: '/foster-parent-application-process', label: 'The Application Process' },
  { href: '/contact-us', label: 'Contact Us' },
];
const facts = [
  'Licensed by the Province of Ontario',
  'Caring for children since 1991',
  'Trauma-informed training provided',
  'A support team behind every family',
];
const points = [
  { icon: 'home', h: 'A safe place to land', p: "Foster care gives a child a stable, temporary home when they can't remain with their birth family, often because of neglect, abuse, or instability. You provide the consistency, warmth, and care they've been missing." },
  { icon: 'pulse', h: 'Trauma-informed care', p: "Many children in care have lived through real trauma. You'll be prepared to understand its impact and help a child feel safe and rebuild trust, gradually and at their own pace." },
  { icon: 'headset', h: 'A team behind you', p: "You are never doing this alone. You work alongside our team, mental-health professionals, and the child's social worker, with support built around each child." },
  { icon: 'leaf', h: 'A bond that lasts', p: 'With patience and consistency, children heal and grow. Many foster parents continue until they retire, and stay part of the lives of the grown children who once shared their home.' },
] as const;
---
<BaseLayout
  title="What Is Foster Parenting? | Annie's Havens"
  description="The term 'foster parent' can mean something different to everyone. Learn what it means to be a foster parent in Ontario with Annie's Havens."
>
  <div class="page-banner">
    <Picture
      base="/images/about-slider-image-1"
      alt="A foster parent and child outdoors"
      width={1920}
      height={600}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim">
      <div class="wrap">
        <h1>What Is Foster Parenting?</h1>
        <p class="lead">In its simplest form, fostering means opening your home and family to a child who isn't related to you, in care regulated under Ontario's Child, Youth and Family Services Act. In practice, it's so much more than that.</p>
      </div>
    </div>
  </div>

  <section class="pad">
    <div class="wrap article">
      <div>
        <div class="prose" style="margin-bottom:40px">
          <p>At Annie's Havens we specialize in caring for children with complex needs. That means fostering here is part caregiver, part advocate, and part steady hand through one of the hardest chapters of a young life. Here's what that really looks like.</p>
        </div>
        <div class="points">
          {points.map((pt) => (
            <article class="point">
              <div class="ic"><Icon name={pt.icon} /></div>
              <h3>{pt.h}</h3>
              <p>{pt.p}</p>
            </article>
          ))}
        </div>
        <blockquote class="pullquote" style="margin-top:40px">A good foster parent is a hero for every child who desperately needs one.</blockquote>
      </div>

      <aside class="aside">
        <div class="aside-card">
          <h3>At a glance</h3>
          <ul class="aside-facts">
            {facts.map((f) => (
              <li><Icon name="leaf" />{f}</li>
            ))}
          </ul>
        </div>
        <div class="aside-card is-cta">
          <h3>Thinking about it?</h3>
          <p>Ask us anything. A real member of our team answers, with no commitment required.</p>
          <a class="btn btn-coral" href="/contact-us">Talk to Our Team</a>
          <a class="call" href={site.phoneHref}>{site.phone}</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
  <ReadMore links={readMore} />
</BaseLayout>
