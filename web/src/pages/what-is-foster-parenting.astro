---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ReadMore from '../components/ReadMore.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const readMore = [
  { href: '/faq', label: 'Frequently Asked Questions' },
  { href: '/care-programs', label: 'Our Care Programs' },
  { href: '/children-in-care', label: 'Children in Care' },
  { href: '/foster-parent-application-process', label: 'The Application Process' },
  { href: '/contact-us', label: 'Contact Us' },
];
const facts = [
  'Licensed by the Province of Ontario (MCCSS)',
  'A founding focus on special needs',
  'PSW and clinical support available',
  'A support team behind every family',
];
const points = [
  { icon: 'home', h: 'A safe place to land', p: "Foster care gives a child a stable home when they can't remain with their birth family. As a foster parent, you provide the consistency, warmth, and care they've been missing." },
  { icon: 'pulse', h: 'Care built for special needs', p: "Annie's Havens specializes in children and youth living with developmental, physical, and medical needs, from mobility needs and Autism Spectrum Disorder to medically fragile children. Our homes are trained and equipped for higher daily care." },
  { icon: 'headset', h: 'A team behind you', p: "You are never doing this alone. Personal Support Workers, Child and Youth Workers, clinical and educational supports, and your case manager all wrap around each placement." },
  { icon: 'leaf', h: 'A bond that lasts', p: 'Because permanency planning takes longer for children with special needs, fostering here is often a long-term commitment, and many families stay part of a child’s life for good.' },
] as const;
---
<BaseLayout
  title="What Is Foster Parenting? | Annie's Havens"
  description="The term 'foster parent' can mean something different to everyone. Learn what it means to be a foster parent in Ontario with Annie's Havens."
>
  <div class="page-banner">
    <Picture
      base="/images/about-slider-image-1"
      alt="A foster parent and child outdoors"
      width={1920}
      height={600}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim">
      <div class="wrap">
        <h1>What Is Foster Parenting?</h1>
        <p class="lead">Fostering means opening your home to a child who needs one. At Annie's Havens, that often means caring for a child or youth living with developmental, physical, or medical needs, and it's so much more than that.</p>
      </div>
    </div>
  </div>

  <section class="pad">
    <div class="wrap article">
      <div>
        <div class="prose" style="margin-bottom:40px">
          <p>Annie's Havens was founded by William and Hilda Wilson and named for their daughter, Annie, who lived with significant physical and medical needs. Caring for Annie gave the agency its founding expertise, and supporting children with special needs is still at the heart of what we do. Here's what fostering with us really looks like.</p>
        </div>
        <div class="points">
          {points.map((pt) => (
            <article class="point">
              <div class="ic"><Icon name={pt.icon} /></div>
              <h3>{pt.h}</h3>
              <p>{pt.p}</p>
            </article>
          ))}
        </div>
        <blockquote class="pullquote" style="margin-top:40px">A good foster parent is a hero for every child who desperately needs one.</blockquote>
      </div>

      <aside class="aside">
        <div class="aside-card">
          <h3>At a glance</h3>
          <ul class="aside-facts">
            {facts.map((f) => (
              <li><Icon name="leaf" />{f}</li>
            ))}
          </ul>
        </div>
        <div class="aside-card is-cta">
          <h3>Thinking about it?</h3>
          <p>Ask us anything. A real member of our team answers, with no commitment required.</p>
          <a class="btn btn-coral" href="/contact-us">Talk to Our Team</a>
          <a class="call" href={site.phoneHref}>{site.phone}</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
  <ReadMore links={readMore} />
</BaseLayout>
