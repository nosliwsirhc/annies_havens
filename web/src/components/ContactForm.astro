---
// Reusable contact form: client-side validation, KinFlow phone formatting,
// Cloudflare Turnstile, and an inline "morph" success state. Submits to the
// /api/contact Worker route. Used on the homepage and /contact-us.
import { site } from '../data/site';
import { FIELD_TOO_LONG } from '../lib/form';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA'; // test key fallback
---
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<div class="form-card" id="form-card">
  <form class="contact" id="contact-form" novalidate data-phone={site.phone}>
    <h3>Send Us a Message</h3>
    <p class="sub">Fields marked <span class="req" aria-hidden="true">*</span> are required. An email or a phone number is fine - fill in whichever you prefer.</p>
    <div class="frow">
      <div class="field"><label for="f-first">First name <span class="req" aria-hidden="true">*</span></label><input id="f-first" name="first" required aria-required="true" /><div class="errmsg" id="err-first" role="alert">Required</div></div>
      <div class="field"><label for="f-last">Last name <span class="opt">(optional)</span></label><input id="f-last" name="last" /><div class="errmsg" id="err-last" role="alert">{FIELD_TOO_LONG}</div></div>
    </div>
    <div class="frow">
      <div class="field"><label for="f-email">Email <span class="opt" id="req-email">(email or phone)</span></label><input id="f-email" name="email" type="email" aria-required="true" /><div class="errmsg" id="err-email" role="alert">Enter a valid email</div></div>
      <div class="field"><label for="f-phone">Phone <span class="opt" id="req-phone">(email or phone)</span></label><input id="f-phone" name="phone" type="tel" aria-required="true" /><div class="errmsg" id="err-phone" role="alert">Required</div></div>
    </div>
    <div class="field"><label for="f-role">I am a… <span class="req" aria-hidden="true">*</span></label>
      <select id="f-role" name="role" required aria-required="true">
        <option value="">Select one</option>
        <option>Prospective Foster Parent</option>
        <option>Current Foster Family</option>
        <option>Professional / Agency Partner</option>
        <option>Community Supporter</option>
        <option>Something Else</option>
      </select>
      <div class="errmsg" id="err-role" role="alert">Please choose one</div>
    </div>
    <div class="field"><label for="f-msg">Message <span class="req" aria-hidden="true">*</span></label><textarea id="f-msg" name="msg" placeholder="How can we help?" required aria-required="true"></textarea><div class="errmsg" id="err-msg" role="alert">Please add a short message</div></div>
    <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible"></div>
    <button type="submit" id="submit-btn" class="btn btn-coral" style="width:100%;justify-content:center;padding:15px;margin-top:16px">Submit Message</button>
    <p class="form-error" id="form-error" role="alert"></p>
  </form>
  <div class="form-ok" id="form-ok" role="status" tabindex="-1">
    <svg class="ok-check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="25"/><path d="M14 27l8 8 16-18"/></svg>
    <h3>Message Sent</h3>
    <p>Thanks for reaching out. A real person on our team reads every message and will get back to you within one business day.</p>
    <button type="button" id="send-another" class="btn btn-out">Send Another Message?</button>
  </div>
</div>

<script>
  import {
    FIELD_MAX_LENGTH, FIELD_TOO_LONG, MESSAGE_MAX_LENGTH, MESSAGE_TOO_LONG,
    formatPhoneWithCaret, isValidEmail, isValidPhone,
  } from '../lib/form';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const phoneInput = document.getElementById('f-phone') as HTMLInputElement | null;
    const formError = document.getElementById('form-error') as HTMLElement | null;
    const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
    const setErr = (n: string, msg: string) => {
      const field = document.getElementById('f-' + n)?.closest('.field');
      const input = document.getElementById('f-' + n);
      const errEl = document.getElementById('err-' + n);
      if (msg) {
        field?.classList.add('err');
        input?.setAttribute('aria-invalid', 'true');
        // Point the field at its error only while it shows one: text that
        // aria-describedby names is read even when hidden, so a permanent
        // link made screen readers announce "Required" with no error (#21).
        input?.setAttribute('aria-describedby', 'err-' + n);
        if (errEl) errEl.textContent = msg;
      } else {
        field?.classList.remove('err');
        input?.removeAttribute('aria-invalid');
        input?.removeAttribute('aria-describedby');
      }
    };
    // True when field `n` already shows exactly `msg`. Rewriting an error's
    // text makes screen readers announce it again (the errors are role=alert),
    // so the same message isn't written twice.
    const isShowing = (n: string, msg: string) =>
      !!document.getElementById('f-' + n)?.closest('.field')?.classList.contains('err') &&
      document.getElementById('err-' + n)?.textContent === msg;
    // A pending re-announcement (see announceFormError) is cancelled by any
    // newer form message, or by clearing it, so it can't overwrite them.
    let announceFrame = 0;
    const showFormError = (m: string) => { cancelAnimationFrame(announceFrame); if (formError) formError.textContent = m; };
    const clearFormError = () => { cancelAnimationFrame(announceFrame); if (formError) formError.textContent = ''; };
    // Say a message in the form's alert even if it's the same text as last
    // time: clear it now and set it on the next frame, so it's announced again.
    const announceFormError = (m: string) => {
      clearFormError();
      announceFrame = requestAnimationFrame(() => { if (formError) formError.textContent = m; });
    };

    const errorsFor = () => {
      const email = val('email'), phone = val('phone');
      const errs: Record<string, string> = {};
      if (!val('first')) errs.first = 'Required';
      else if (val('first').length > FIELD_MAX_LENGTH) errs.first = FIELD_TOO_LONG;
      if (val('last').length > FIELD_MAX_LENGTH) errs.last = FIELD_TOO_LONG;
      if (email.length > FIELD_MAX_LENGTH) errs.email = FIELD_TOO_LONG;
      else if (email && !isValidEmail(email)) errs.email = 'Enter a valid email';
      if (phone && !isValidPhone(phone)) errs.phone = 'Enter a 10-digit phone number';
      if (!email && !phone) { errs.email = 'Enter an email or phone number'; errs.phone = 'Enter an email or phone number'; }
      if (!val('role')) errs.role = 'Please choose one';
      if (!val('msg')) errs.msg = 'Please add a short message';
      else if (val('msg').length > MESSAGE_MAX_LENGTH) errs.msg = MESSAGE_TOO_LONG;
      return errs;
    };

    const updateContactReq = () => {
      const emailFilled = !!val('email'), phoneFilled = !!val('phone');
      const toggle = (name: string, required: boolean) => {
        const star = document.getElementById('req-' + name);
        if (star) star.style.display = required ? '' : 'none';
        document.getElementById('f-' + name)?.setAttribute('aria-required', required ? 'true' : 'false');
      };
      toggle('email', !phoneFilled);
      toggle('phone', !emailFilled);
    };

    // Submit stays enabled (#25): pressing it with problems shows every error
    // and moves focus to the first one, rather than a greyed-out button that
    // never says why. It's only disabled while a message is sending.
    const refresh = () => {
      updateContactReq();
    };

    ['first', 'last', 'email', 'phone', 'role', 'msg'].forEach((n) => {
      document.getElementById('f-' + n)?.addEventListener('blur', () => {
        const err = errorsFor()[n] || '';
        if (!err || !isShowing(n, err)) setErr(n, err);
      });
    });

    form.querySelectorAll('input, select, textarea').forEach((el) =>
      el.addEventListener('input', () => {
        if (el === phoneInput && phoneInput) {
          const pos = phoneInput.selectionStart ?? phoneInput.value.length;
          const { value, caret } = formatPhoneWithCaret(phoneInput.value, pos);
          phoneInput.value = value;
          phoneInput.setSelectionRange(caret, caret);
        }
        // Clear this field's error while typing, except a length error, which
        // shows as soon as it applies. It is written once when it appears, not
        // on every keystroke.
        const name = (el as HTMLInputElement).name;
        const err = errorsFor()[name];
        if (err === MESSAGE_TOO_LONG || err === FIELD_TOO_LONG) {
          if (!isShowing(name, err)) setErr(name, err);
        } else {
          setErr(name, '');
        }
        clearFormError();
        // Clear email's or phone's error once it no longer applies (one way to
        // reach them is enough, so filling in either can resolve the other's
        // "Enter an email or phone number"), but never one that still does,
        // such as an invalid email next to a valid phone.
        (['email', 'phone'] as const).forEach((n) => { if (!errorsFor()[n]) setErr(n, ''); });
        refresh();
      })
    );

    const card = document.getElementById('form-card');
    const okEl = document.getElementById('form-ok');
    const morph = (swap: () => void) => {
      if (!card) { swap(); return; }
      const startH = card.offsetHeight;
      swap();
      const endH = card.offsetHeight;
      card.style.height = startH + 'px';
      void card.offsetHeight;
      card.style.height = endH + 'px';
      const done = (e: TransitionEvent) => {
        if (e.propertyName !== 'height') return;
        card.style.height = 'auto';
        card.removeEventListener('transitionend', done);
      };
      card.addEventListener('transitionend', done);
    };

    // Give up on a send that hasn't answered by then, rather than leave
    // "Sending…" up forever.
    const SEND_TIMEOUT_MS = 20000;
    const CHECK_FIELDS = 'Some fields still need attention. Each one says what’s missing.';

    let submitting = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting) return;
      const errs = errorsFor();
      const order = ['first', 'last', 'email', 'phone', 'role', 'msg'];
      if (Object.keys(errs).length) {
        clearFormError();
        // Show every error, but don't rewrite one that's already showing: each
        // is role=alert, and rewriting it would announce it again.
        let shownNew = false;
        order.forEach((n) => {
          const err = errs[n] || '';
          if (!err || !isShowing(n, err)) { if (err) shownNew = true; setErr(n, err); }
        });
        // The first invalid field now describes its error when focused.
        const before = document.activeElement;
        document.getElementById('f-' + order.find((n) => errs[n]))?.focus();
        // A press that shows nothing new and doesn't move focus (Enter again in
        // the same empty field) would be silent for a screen reader, so say it
        // in the form's own alert. When focus moves, the field's label and
        // error are read instead, and an alert would talk over them.
        if (!shownNew && document.activeElement === before) announceFormError(CHECK_FIELDS);
        return;
      }
      const token = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value || '';
      if (!token) {
        // If the Turnstile widget rendered, ask them to complete it. If it
        // never loaded (blocked/offline), don't leave them stuck - offer a phone.
        const widgetLoaded = !!form.querySelector('.cf-turnstile iframe');
        const phone = form.dataset.phone;
        announceFormError(widgetLoaded
          ? 'Please complete the verification below, then submit again.'
          : `Verification could not load. Please refresh the page${phone ? `, or call us at ${phone}` : ''}.`);
        return;
      }

      submitting = true;
      clearFormError();
      const label = submitBtn?.textContent;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), SEND_TIMEOUT_MS);
      let failure = '';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ first: val('first'), last: val('last'), email: val('email'), phone: val('phone'), role: val('role'), msg: val('msg'), token }),
          signal: controller.signal,
        });
        // The deadline covers reading the reply too, so a stalled body can't
        // leave "Sending…" up. In production /api/contact answers 200 only once
        // the email has been accepted for delivery (every failure is a 4xx or
        // 5xx), so a 200 whose body was lost (timed out, or the connection
        // dropped) still counts as sent. A body that arrived but isn't JSON
        // (a SyntaxError) isn't the endpoint's reply, so that stays a failure.
        let bodyLost = false;
        const data = await res.json().catch((err) => { bodyLost = !(err instanceof SyntaxError); return {}; });
        if (res.ok && (data.ok || bodyLost)) {
          // GA4 conversion (only fires if the visitor accepted analytics; gtag is undefined otherwise).
          (window as any).gtag?.('event', 'generate_lead', { form_location: location.pathname });
          morph(() => { form.style.display = 'none'; okEl?.classList.add('show'); });
          okEl?.focus();
        } else {
          failure = data.error || 'Something went wrong. Please try again, or call us.';
        }
      } catch {
        // Timed out (the server may still have sent it), or a network failure.
        failure = controller.signal.aborted
          ? 'This is taking longer than expected, so your message may not have been sent. Please try again, or call us.'
          : 'We couldn’t reach the server. Please try again, or call us.';
      } finally {
        window.clearTimeout(timer);
        submitting = false;
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = label || 'Submit Message'; }
        refresh();
      }
      if (failure) {
        // Disabling the button while it had focus dropped focus to the page.
        // Put it back on the button first, so the move doesn't cut off the
        // announcement of the problem that follows.
        const active = document.activeElement;
        if (submitBtn && (!active || active === document.body)) submitBtn.focus();
        showFormError(failure);
        (window as any).turnstile?.reset();
      }
    });

    document.getElementById('send-another')?.addEventListener('click', () => {
      morph(() => {
        okEl?.classList.remove('show');
        form.style.display = '';
        form.reset();
        clearFormError();
        ['first', 'last', 'email', 'phone', 'role', 'msg'].forEach((n) => setErr(n, ''));
        (window as any).turnstile?.reset();
        refresh();
      });
      document.getElementById('f-first')?.focus();
    });

    // Firefox can restore a button's disabled state on reload (e.g. reloaded
    // mid-send), so start enabled.
    if (submitBtn) submitBtn.disabled = false;
    refresh();
  }
</script>
