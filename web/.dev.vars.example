# Copy to `.dev.vars` for local testing. In production these are Worker secrets
# (`wrangler secret put <NAME> --name annies-havens-web`). `.dev.vars` is gitignored.
#
# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile):
#   PUBLIC_TURNSTILE_SITE_KEY is exposed to the browser (the widget).
#   TURNSTILE_SECRET_KEY is server-only.
# Leave unset locally to use Cloudflare's always-pass TEST keys.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com) — server-only. Without it, the form returns a
# dev-only success locally and errors in production.
RESEND_TOKEN=

# Where inquiries are sent / sent from (the "from" domain must be verified in Resend).
CONTACT_TO=recruitment@annieshavens.ca
CONTACT_FROM=Annie's Havens <noreply@annieshavens.ca>

# Delivery alerts (/api/resend-events, a Resend webhook). The webhook's signing
# secret (whsec_...) from the Resend dashboard, and where alerts go: one bare
# address (no display name), or several separated by commas. Alerts carry inquirers' details, so use a
# mailbox the agency controls (not a personal account), and not the CONTACT_TO
# address, so an alert still arrives when that address is the problem. If an
# alert can't be delivered, CONTACT_TO gets a notice instead.
RESEND_WEBHOOK_SECRET=
ALERT_TO=
